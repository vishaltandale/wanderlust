<% layout('layouts/boilerplate') -%>

<div class="row mt-3">
    <div class="col-10 offset-1">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/listings">Listings</a></li>
                <li class="breadcrumb-item active"><%= listing.title %></li>
            </ol>
        </nav>
    </div>

    <div class="col-8 offset-2">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
                <h3><%= listing.title %></h3>
                <% if(listing.category) { %>
                    <span class="badge bg-dark category-badge"><%= listing.category %></span>
                <% } %>
            </div>
            <% if(typeof currentUser !== 'undefined' && currentUser) { %>
                <a href="/bookings/new/<%= listing._id %>" class="btn btn-dark btn-lg book-btn">
                    <i class="fa-solid fa-calendar-check"></i> Book Now
                </a>
            <% } %>
        </div>
    </div>

    <div class="card col-8 offset-2 show-card listing-card mt-2">
        <img
            src="<%= listing.image.url %>"
            class="card-img-top show-img"
            alt="listing_image"
        />

        <div class="card-body mt-3">
            <p class="card-text">
                <%= listing.description %> <br><br>
                <strong>&#8377; <%= listing.price.toLocaleString("en-IN") %></strong> /night <br>
                <i class="fa-solid fa-location-dot"></i> <%= listing.location %> <br>
                <i class="fa-solid fa-globe"></i> <%= listing.country %>
            </p>

            <% if(listing.owner) { %>
                <p class="card-text">
                    <small class="text-muted">
                        <i class="fa-solid fa-user"></i> Hosted by <strong><%= listing.owner.fullName %></strong>
                    </small>
                </p>
            <% } %>
        </div>
    </div>

    <% if(typeof currentUser !== 'undefined' && currentUser && listing.owner && listing.owner._id.toString() === currentUser._id.toString()) { %>
    <div class="col-8 offset-2 mt-3">
        <div class="btn-group">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">
                <i class="fa-solid fa-pen-to-square"></i> Edit
            </a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this listing?')">
                    <i class="fa-solid fa-trash"></i> Delete
                </button>
            </form>
        </div>
    </div>
    <% } %>

    <div class="col-8 offset-2 mb-3 mt-4">
        <hr>

        <% if(listing.reviews.length > 0) { %>
            <div class="d-flex align-items-center mb-3">
                <h4 class="me-3">Reviews</h4>
                <span class="text-warning">
                    <% for(let i = 0; i < Math.round(parseFloat(avgRating)); i++) { %>
                        <i class="fa-solid fa-star"></i>
                    <% } %>
                </span>
                <span class="ms-2 text-muted"><%= avgRating %> / 5 (<%= listing.reviews.length %> review<%= listing.reviews.length !== 1 ? 's' : '' %>)</span>
            </div>
        <% } else { %>
            <h4>Reviews</h4>
            <p class="text-muted">No reviews yet.</p>
        <% } %>

        <% if(typeof currentUser !== 'undefined' && currentUser) { %>
            <div class="card p-3 mb-4">
                <h5>Leave a Review</h5>
                <form
                    action="/listings/<%= listing._id %>/reviews"
                    method="POST"
                    novalidate
                    class="needs-validation">
                    <div class="mb-3">
                        <label class="form-label">Rating</label>
                        <div class="star-rating">
                            <input type="radio" id="star5" name="review[rating]" value="5" required />
                            <label for="star5" title="5 stars"><i class="fa-solid fa-star"></i></label>
                            <input type="radio" id="star4" name="review[rating]" value="4" />
                            <label for="star4" title="4 stars"><i class="fa-solid fa-star"></i></label>
                            <input type="radio" id="star3" name="review[rating]" value="3" />
                            <label for="star3" title="3 stars"><i class="fa-solid fa-star"></i></label>
                            <input type="radio" id="star2" name="review[rating]" value="2" />
                            <label for="star2" title="2 stars"><i class="fa-solid fa-star"></i></label>
                            <input type="radio" id="star1" name="review[rating]" value="1" />
                            <label for="star1" title="1 star"><i class="fa-solid fa-star"></i></label>
                        </div>
                        <div class="invalid-feedback">Please select a rating.</div>
                    </div>
                    <div class="mb-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea
                            name="review[comment]"
                            id="comment"
                            cols="30"
                            rows="3"
                            class="form-control"
                            required
                            placeholder="Share your experience..."
                        ></textarea>
                        <div class="invalid-feedback">Please add some comments.</div>
                    </div>
                    <button class="btn btn-outline-dark btn-sm">
                        <i class="fa-solid fa-paper-plane"></i> Submit Review
                    </button>
                </form>
            </div>
        <% } else { %>
            <p class="text-muted"><a href="/login">Log in</a> to leave a review.</p>
        <% } %>

        <% if(listing.reviews.length > 0) { %>
            <div class="row g-3">
                <% for(let review of listing.reviews) { %>
                <div class="col-md-6">
                    <div class="card review-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="card-title mb-0">
                                    <i class="fa-solid fa-user-circle"></i>
                                    <%= review.author ? review.author.fullName : 'Traveler' %>
                                </h6>
                                <span class="badge bg-warning text-dark">
                                    <% for(let i = 0; i < review.rating; i++) { %>
                                        <i class="fa-solid fa-star" style="font-size: 0.7rem;"></i>
                                    <% } %>
                                </span>
                            </div>
                            <p class="card-text"><%= review.comment %></p>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted"><%= review.createdAt.toLocaleDateString() %></small>
                                <% if(typeof currentUser !== 'undefined' && currentUser &&
                                    ((review.author && review.author._id.toString() === currentUser._id.toString()) ||
                                    (listing.owner && listing.owner._id.toString() === currentUser._id.toString()))) { %>
                                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                        <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this review?')">
                                            <i class="fa-solid fa-trash"></i> Delete
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>
